      "to": "dotsys",
      "variant": "emphasis",
      "route": "drop",
      "fromSide": "bottom",
      "toSide": "top"
    },
    {
      "from": "dotsys",
      "to": "mounts",
      "route": "bottom-channel",
      "fromSide": "bottom",
      "toSide": "bottom"
