  "cards": [
    {
      "dot": "emerald",
      "title": "One pass, ordered",
      "items": [
        "hooks-pre \u2192 packages \u2192 tools \u2192 dotfiles \u2192 dotfiles-system \u2192 mounts/smb \u2192 hooks-post",
        "Section flags filter which steps execute",
        "The full plan is printed and snapshotted regardless"
      ]
    },
    {
      "dot": "amber",
      "title": "Scoped execution",
      "items": [
        "User-scope steps run as the invoking user",
        "System targets converge elevated in one sudo pass",
        "Mounts and smb activate after files land"
      ]
    },
    {
      "dot": "rose",
      "title": "Crash-safe resume",
      "items": [
        "The cursor records the last completed step",
        "A sidecar flock serializes concurrent applies",
        "A completed apply deletes its cursor"
      ]
    }
  ]
