STATUS
profile: $PROFILE
state: $STATE/state.json
resume: last completed "packages:demo" - next apply resumes after it
packages:
  shell: emacs - still installed
  shell: nano - still installed
tools:
  shell: node - mise current failed: no mise (?)
  shell: python - mise current failed: no mise (?)
dotfiles:
  shell: /home/cri/.bashrc - content differs
  shell: ~/.config/fish - bootstrap files: read symlink-each source $PROFILE/hosts/myhost/modules/shell/fish: open $PROFILE/hosts/myhost/modules/shell/fish: not a directory (?)
orphans:
  base:
    shell: .bashrc - not referenced by [dotfiles]
  hosts/myhost:
    shell: .bashrc - not referenced by [dotfiles]

drift: 5 items, 3 unknown
note: configuration exists for other accounts on this machine:
  users/root — apply with: sudo dotdrift apply
  (each account needs dotdrift on its PATH — install it system-wide, e.g. via mise, system scope)
