MODULE shell — raw declarations

[base] modules/shell/module.toml
  packages present: neovim, ripgrep, nano · absent: emacs
  tools: node=20
  dotfiles:
    ~/.bashrc ← .bashrc (symlink)
  hooks:
    pre:  echo base-pre
    post: echo base-post

[hosts/myhost] hosts/myhost/modules/shell/module.toml
  packages present: fd · absent: neovim
  tools: node=22, python=3.11
  dotfiles:
    ~/.bashrc ← .bashrc (symlink)
    ~/.config/fish ← fish (symlink-each)
  hooks:
    pre:  echo host-pre
    post: echo host-post

[users/cri] users/cri/modules/shell/module.toml
  packages present: neovim, eza · absent: nano
  tools: python=3.12
  dotfiles:
    ~/.bashrc ← .bashrc (copy)
  hooks:
    pre:  echo user-pre
    post: echo user-post