PLAN
fingerprint:
selected=shell
disable=
hostname=myhost
username=cri
os=linux
kernel=6.12.1-arch1-1
gpu= amd
backend=pacman
packages:
  - eza
  - fd
  - neovim
  - ripgrep
remove:
  - emacs
  - nano
tools:
  node: 22
  python: 3.12
dotfiles:
  ~/.bashrc:
    source: $PROFILE/users/cri/modules/shell/.bashrc
    mode: copy
    module: shell
    layer: user
  ~/.config/fish:
    source: $PROFILE/hosts/myhost/modules/shell/fish
    mode: symlink-each
    module: shell
    layer: host
hooks:
  pre:
    - echo base-pre
    - echo host-pre
    - echo user-pre
  post:
    - echo base-post
    - echo host-post
    - echo user-post

diffs

[shell] /home/cri/.bashrc
--- /home/cri/.bashrc
+++ $PROFILE/users/cri/modules/shell/.bashrc
@@ -1,7 +1,2 @@
-#
-# ~/.bashrc
-#
+user bashrc

-# If not running interactively, don't do anything
-[[ $- != *i* ]] && return
-

apply: arrives with T-tui-apply — the plan gate will be the TUI's only write path.