      "fromSide": "bottom",
      "toSide": "bottom"
    },
    {
      "from": "packages",
      "to": "tools",
      "route": "bottom-channel",
      "fromSide": "bottom",
      "toSide": "bottom"
    },
    {
      "from": "tools",
      "to": "dotfiles",
      "route": "bottom-channel",
      "fromSide": "bottom",
      "toSide": "bottom"
    },
